    {
      "id": "BCF-AC-001",
      "text": "内外部新增分支、名称/KEY100与101、重名/重复KEY、并发提交及取消分别验证",
      "requirement": "BCF-001"
    },
    {
      "id": "BCF-AC-002",
      "text": "外部应用身份三项不可改，场景组合及URL500/501、非法协议、失效目标按批准规则处理",
      "requirement": "BCF-002"
    },
    {
      "id": "BCF-AC-003",
      "text": "系统名称100/101、URL500/501、介绍1000/1001、KEY失效及两种打开方式与前台结果对应",
      "requirement": "BCF-003"
    },
    {
      "id": "BCF-AC-004",
      "text": "Logo/手册允许格式、伪装格式、大小边界、上传中取消和失败重试符合批准规则，不泄露凭据",
      "requirement": "BCF-003"
    },
    {
      "id": "BCF-AC-005",
      "text": "平台分类是/否两分支、添加系统为空/重复/失权、名称100/101及介绍1000/1001正确处理",
      "requirement": "BCF-004"
    },
    {
      "id": "BCF-AC-006",
      "text": "平台排序/启停/删除的引用影响与直接路径权限一致；取消、冲突和失败后顺序可恢复",
      "requirement": "BCF-004"
    },
    {
      "id": "BCF-AC-007",
      "text": "字典分类切换、编码20/21、名称100/101、内置与租户自定义差异、编辑编码伪造和引用删除分别验证",
      "requirement": "BCF-005"
    },
    {
      "id": "BCF-AC-008",
      "text": "特殊日期重复/闰日/跨年/逆序查询、编辑日期不可改、备注500/501、引用删除及超时重试明确",
      "requirement": "BCF-006"
    },
    {
      "id": "BCF-AC-009",
      "text": "许可概要与产品截止日期一致；更换失败保持旧许可、重复提交幂等、超额/到期按批准策略处理",
      "requirement": "BCF-007"
    },
    {
      "id": "BCF-AC-010",
      "text": "后台数据源各真实入口与业务入口对象一致，失权、直接路由和跨部门查询不能绕过授权",
      "requirement": "BCF-008"
    }
