  "originalCases": [
    {
      "id": "BAS-AC-018",
      "requirement": "BAS-001",
      "text": "按测试账号查询并核对返回行身份。"
    },
    {
      "id": "BAS-AC-019",
      "requirement": "BAS-001",
      "text": "无匹配结果显示空状态，保留条件。"
    },
    {
      "id": "BAS-AC-020",
      "requirement": "BAS-001",
      "text": "分别验证无权与服务错误，不能都显示为空列表。"
    },
    {
      "id": "BAS-AC-021",
      "requirement": "BAS-001",
      "text": "快速切换页码及条件，核对迟到响应。"
    },
    {
      "id": "BAS-AC-022",
      "requirement": "BAS-001",
      "text": "重置后确认筛选、页码及实际请求；不把样本总数写成容量。"
    },
    {
      "id": "BAS-AC-023",
      "requirement": "BAS-002",
      "text": "合法4/20位账号及合法资料创建；检查newPwd请求键并回读真实id。"
    },
    {
      "id": "BAS-AC-024",
      "requirement": "BAS-002",
      "text": "分别输入3/21位、含下划线/中文账号；前端不得正常提交；绕过前端的后端校验另测。"
    },
    {
      "id": "BAS-AC-025",
      "requirement": "BAS-002",
      "text": "两次密码不一致阻止提交；重复账号由真实后端拒绝且不能覆盖原用户。"
    },
    {
      "id": "BAS-AC-026",
      "requirement": "BAS-002",
      "text": "模拟网络中断与业务拒绝，核对loading清除、错误显示及草稿；超时先回读再重试。"
    },
    {
      "id": "BAS-AC-027",
      "requirement": "BAS-002",
      "text": "取消后无创建/更新请求；普通用户直接访问和重复提交分别检查授权及单次写入。"
    },
    {
      "id": "BAS-AC-028",
      "requirement": "BAS-003",
      "text": "读取测试用户；账号不可编辑，保存后回读除账号外的允许修改字段。"
    },
    {
      "id": "BAS-AC-029",
      "requirement": "BAS-003",
      "text": "分别输入3/21位、含下划线/中文账号；前端不得正常提交；绕过前端的后端校验另测。"
    },
    {
      "id": "BAS-AC-030",
      "requirement": "BAS-003",
      "text": "联系方式未变/改变分别检查null和加密参数；gender空值检查-1。"
    },
    {
      "id": "BAS-AC-031",
      "requirement": "BAS-003",
      "text": "模拟网络中断与业务拒绝，核对loading清除、错误显示及草稿；超时先回读再重试。"
    },
    {
      "id": "BAS-AC-032",
      "requirement": "BAS-003",
      "text": "取消后无创建/更新请求；普通用户直接访问和重复提交分别检查授权及单次写入。"
    },
    {
      "id": "BAS-AC-033",
      "requirement": "BAS-004",
      "text": "保存合法范围并回读边界。"
    },
    {
      "id": "BAS-AC-034",
      "requirement": "BAS-004",
      "text": "检查两个默认时刻和实际发送格式。"
    },
    {
      "id": "BAS-AC-035",
      "requirement": "BAS-004",
      "text": "结束早于开始、相同边界及过期账号由后端规则确认后验收。"
    },
    {
      "id": "BAS-AC-036",
      "requirement": "BAS-004",
      "text": "清空后回读并确认其真实业务含义。"
    },
    {
      "id": "BAS-AC-037",
      "requirement": "BAS-004",
      "text": "取消不请求；无权、超时与重复保存不伪报成功。"
    },
    {
      "id": "BAS-AC-038",
      "requirement": "BAS-005",
      "text": "不可管理的既有角色不能被页面误删除；回读最终角色集合。"
    },
    {
      "id": "BAS-AC-039",
      "requirement": "BAS-005",
      "text": "取消启停/强制退出确认，不发请求；确认后只处理目标测试账号。"
    },
    {
      "id": "BAS-AC-040",
      "requirement": "BAS-005",
      "text": "分别测试两种重置配置；不记录密码或加密结果。"
    },
    {
      "id": "BAS-AC-041",
      "requirement": "BAS-005",
      "text": "密码不一致、管理员密码错误、无权与服务失败应拒绝且不伪报成功。"
    },
    {
      "id": "BAS-AC-042",
      "requirement": "BAS-005",
      "text": "核对强制退出实际会话范围、角色生效时机和审计；超时先回读，避免重复操作。"
    },
    {
      "id": "BAS-AC-043",
      "requirement": "BAS-006",
      "text": "编码1/20位通过客户端，空/21位/中文编码阻止。"
    },
    {
      "id": "BAS-AC-044",
      "requirement": "BAS-006",
      "text": "名称100/101位、纯空白、混合空白分别核对；一级节点编辑状态正确。"
    },
    {
      "id": "BAS-AC-045",
      "requirement": "BAS-006",
      "text": "父节点pid对应所选节点；新增和编辑回读同一树。"
    },
    {
      "id": "BAS-AC-046",
      "requirement": "BAS-006",
      "text": "禁用候选不被越权提交；删除有子部门/成员时按后端规则保护。"
    },
    {
      "id": "BAS-AC-047",
      "requirement": "BAS-006",
      "text": "取消、失败、重复和并发移动均核对树及人员关系不误变更。"
    },
    {
      "id": "BAS-AC-048",
      "requirement": "BAS-007",
      "text": "排除现有成员且编辑人员不可替换；重复绑定由后端拒绝。"
    },
    {
      "id": "BAS-AC-049",
      "requirement": "BAS-007",
      "text": "职位空与100/101位边界，leader=false可以表达非领导。"
    },
    {
      "id": "BAS-AC-050",
      "requirement": "BAS-007",
      "text": "回读关系id、用户id和部门id；移除后用户账号仍存在。"
    },
    {
      "id": "BAS-AC-051",
      "requirement": "BAS-007",
      "text": "取消移除无DELETE；本人关系移除后的页面和主部门需核对。"
    },
    {
      "id": "BAS-AC-052",
      "requirement": "BAS-007",
      "text": "跨部门越权、网络失败、重复与并发绑定核对成员集合和审计。"
    },
    {
      "id": "BAS-AC-053",
      "requirement": "BAS-008",
      "text": "空/50/51位名称分别核对客户端规则及后端结果。"
    },
    {
      "id": "BAS-AC-054",
      "requirement": "BAS-008",
      "text": "勾选依赖权限，取消被依赖权限，核对本地集合。"
    },
    {
      "id": "BAS-AC-055",
      "requirement": "BAS-008",
      "text": "保存和回读叶节点，确认父节点不被误当业务授权。"
    },
    {
      "id": "BAS-AC-056",
      "requirement": "BAS-008",
      "text": "取消全选/取消页面不提交；删除已绑定角色保护待后端规则明确后执行。"
    },
    {
      "id": "BAS-AC-057",
      "requirement": "BAS-008",
      "text": "普通用户直达、跨租户授权、重复及并发保存应由后端鉴权并审计。"
    },
    {
      "id": "BAS-AC-058",
      "requirement": "BAS-009",
      "text": "名称空/100/101位和纯空白边界；管理员缺失阻止提交。"
    },
    {
      "id": "BAS-AC-059",
      "requirement": "BAS-009",
      "text": "分别核对启用工作区两个开关及编辑禁用；不把true强加给后端默认。"
    },
    {
      "id": "BAS-AC-060",
      "requirement": "BAS-009",
      "text": "多选绑定和移除回读关系集合；原账号仍存在。"
    },
    {
      "id": "BAS-AC-061",
      "requirement": "BAS-009",
      "text": "租户保存通知顶栏刷新；取消不发送租户或成员写请求。"
    },
    {
      "id": "BAS-AC-062",
      "requirement": "BAS-009",
      "text": "跨租户访问/授权、删除非空租户、并发绑定、网络与重复请求按后端结果验收。"
    },
    {
      "id": "BAS-AC-063",
      "requirement": "BAS-010",
      "text": "同账号比较全局与本人范围，记录服务端对象集合。"
    },
    {
      "id": "BAS-AC-064",
      "requirement": "BAS-010",
      "text": "无可管理对象呈空态，不能显示系统错误。"
    },
    {
      "id": "BAS-AC-065",
      "requirement": "BAS-010",
      "text": "跨范围id直接请求应拒绝，不能仅隐藏菜单。"
    },
    {
      "id": "BAS-AC-066",
      "requirement": "BAS-010",
      "text": "失权/过期会话不能提交；刷新后范围更新。"
    },
    {
      "id": "BAS-AC-067",
      "requirement": "BAS-010",
      "text": "核对my写接口、失败及审计；未确定接口参数前不照搬全局写契约。"
    },
    {
      "id": "BAS-AC-068",
      "requirement": "BAS-011",
      "text": "编码1/20/21位及非法字符分别检查。"
    },
    {
      "id": "BAS-AC-069",
      "requirement": "BAS-011",
      "text": "名称空、100/101位及纯空白记录实际前后端差别。"
    },
    {
      "id": "BAS-AC-070",
      "requirement": "BAS-011",
      "text": "业务类型空转null；多个英文逗号段与非法分隔符校验。"
    },
    {
      "id": "BAS-AC-071",
      "requirement": "BAS-011",
      "text": "被部门或人员引用时删除保护，规则确认后验收。"
    },
    {
      "id": "BAS-AC-072",
      "requirement": "BAS-011",
      "text": "取消、失败、重复、无权与跨租户操作不误更新标签关系。"
    },
    {
      "id": "BAS-AC-073",
      "requirement": "BAS-012",
      "text": "账号4/20位，3/21位与非法字符分别检查。"
    },
    {
      "id": "BAS-AC-074",
      "requirement": "BAS-012",
      "text": "只填账号可走账号分支，IP为空不应阻挡该分支。"
    },
    {
      "id": "BAS-AC-075",
      "requirement": "BAS-012",
      "text": "只填合法IP走IP分支；非法IP前端阻止。"
    },
    {
      "id": "BAS-AC-076",
      "requirement": "BAS-012",
      "text": "无锁定对象、无权、失败与超时不能伪报已解禁。"
    },
    {
      "id": "BAS-AC-077",
      "requirement": "BAS-012",
      "text": "重复解禁与审计、解禁后登录由隔离账号验证；取消不请求。"
    },
    {
      "id": "BAS-AC-001",
      "requirement": "BAS-001",
      "text": "按账号/姓名/状态组合查询、清空重查和翻页；空值、无匹配、加载失败可恢复，过期与启用分别展示"
    },
    {
      "id": "BAS-AC-002",
      "requirement": "BAS-002",
      "text": "用户账号20/21、姓名10/11、联系方式边界及非法格式分别验证客户端与服务端；密码遵循批准策略"
    },
    {
      "id": "BAS-AC-003",
      "requirement": "BAS-002",
      "text": "同账号并发创建只生成一个批准范围内的用户；失败、重复提交、取消不生成半成品角色/成员关系"
    },
    {
      "id": "BAS-AC-004",
      "requirement": "BAS-003",
      "text": "编辑不能改账号、附加密码或越权用户标识；并发冲突不覆盖新版本，取消后原值保持"
    },
    {
      "id": "BAS-AC-005",
      "requirement": "BAS-004",
      "text": "有效期未设置、相等起止、逆序、过期、清空及时区切换按批准规则处理；超时先回读再重试"
    },
    {
      "id": "BAS-AC-006",
      "requirement": "BAS-005",
      "text": "角色双列含已选/可选，失权候选拒绝提交；提交成功只改变目标用户关系"
    },
    {
      "id": "BAS-AC-007",
      "requirement": "BAS-005",
      "text": "重置密码、禁用默认租户、禁用账号、强制退出和删除分别确认对象、权限、结果及审计，取消不生效"
    },
    {
      "id": "BAS-AC-008",
      "requirement": "BAS-006",
      "text": "未选节点、根节点和普通节点的新增/修改/删除权限正确；编码20/21、名称100/101及同级冲突明确"
    },
    {
      "id": "BAS-AC-009",
      "requirement": "BAS-006",
      "text": "带子部门/成员/主部门引用时删除受批准保护；上下移失败不误显示成功，刷新保持真实顺序"
    },
    {
      "id": "BAS-AC-010",
      "requirement": "BAS-007",
      "text": "重复人员、无候选、失效账号、角色/标签组合和领导属性按批准规则验证；删除部门关系不误删账号"
    },
    {
      "id": "BAS-AC-011",
      "requirement": "BAS-008",
      "text": "角色名50/51、重名、权限树父子/半选、全选/取消全选和越权权限伪造均有明确处理"
    },
    {
      "id": "BAS-AC-012",
      "requirement": "BAS-008",
      "text": "角色授权撤回的生效时机与审计符合批准规则；被引用角色不能无提示删除"
    },
    {
      "id": "BAS-AC-013",
      "requirement": "BAS-009",
      "text": "租户名100/101、管理域500/501、管理员失效、许可配额及空间选项编辑禁用均按批准规则验证"
    },
    {
      "id": "BAS-AC-014",
      "requirement": "BAS-009",
      "text": "租户创建失败不留半成品，成员重复和跨租户请求被正确处理，删除成员不误删平台用户"
    },
    {
      "id": "BAS-AC-015",
      "requirement": "BAS-010",
      "text": "我的用户/部门按管理关系隔离，空结果与失败分开，直接路径和伪造范围不能获得全量数据"
    },
    {
      "id": "BAS-AC-016",
      "requirement": "BAS-011",
      "text": "有维护权限后验证自定义标签新增、重名、引用保护；内置样本无操作不被误解释成全局禁止维护"
    },
    {
      "id": "BAS-AC-017",
      "requirement": "BAS-012",
      "text": "账号20/21、IP15/16及IPv6输入与批准规则一致；无对应限制、重复解除、失败重试、越权均有明确结果"
    }
  ],
